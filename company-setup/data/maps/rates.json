  "info": {
    "fed": {
      "what": "미국 중앙은행이 정하는 하루짜리 금리. 세계 돈값의 출발점이라 미 채권금리와 달러가 여기서 움직인다.",
      "watch": "FOMC 일정(연 8회) · 점도표 · 의장 발언 · 미 고용 · 물가 지표"
    },
    "bok": {
      "what": "한국은행 금통위가 정하는 기준금리. 국고채 · 대출금리 · 원화 값의 바탕이고, 연준과 벌어지면 환율이 흔들린다.",
      "watch": "금통위 일정(연 8회) · 한미 금리차 · 가계부채 · 국내 물가"
    },
    "ust": {
      "what": "미 국채 10년물 금리. 세계 주식 · 부동산의 할인율이라 이것이 오르면 먼 미래 이익이 큰 성장주가 먼저 받는다.",
      "watch": "10년물 · 2년물 · 장단기 금리차 · 미 재정적자 · 국채 입찰"
    },
    "ktb": {
      "what": "국고채 3년 · 10년 금리. 은행 예대마진 · 보험 운용수익 · 주택담보대출 금리가 여기서 나온다.",
      "watch": "국고채 3년 · 10년 · 한미 금리차 · 외국인 채권 자금"
    },
    "usd": {
      "what": "달러의 값. 원자재(유가)는 달러로 사고, 수출 대금도 달러로 받는다. 달러가 세면 유가는 눌리고 원화 수출주는 환차익을 본다.",
      "watch": "달러인덱스 · 원/달러 · 외국인 순매수 · 한미 금리차",
      "choke": "한 통화 쏠림 — 원자재 · 무역 결제가 달러 하나로 몰려 있어 달러가 움직이면 유가와 수출주가 한꺼번에 받는다"
    },
    "opec": {
      "what": "산유국 모임(OPEC+)이 감산 · 증산으로 공급량을 정한다. 수요가 그대로여도 여기서 유가가 뒤집힌다.",
      "watch": "OPEC+ 회의 · 감산 이행률 · 미 셰일 생산량 · 중동 정세",
      "choke": "소수 공급 — 세계 원유 공급의 큰 몫을 몇 나라가 쥐고 있어 회의 한 번에 유가 방향이 바뀐다"
    },
    "wti": {
      "what": "미국(WTI) · 북해(브렌트) 기준 유가. 정유 · 화학의 원가이자 항공 · 해운의 연료비이고, 물가로 번져 금리까지 되돌아간다.",
      "watch": "WTI · 브렌트 · 미 원유 재고(EIA) · 정제마진 · 달러인덱스"
    },
    "cpi": {
      "what": "소비자물가와 기대 인플레. 유가가 올라 물가가 오르면 중앙은행이 금리를 올리게 된다 — 이 지도의 오른쪽에서 왼쪽으로 되돌아가는 고리.",
      "watch": "미 CPI · PCE · 국내 CPI · 기대 인플레 · 유가"
    },
    "bank": {
      "what": "금리가 오르면 예대마진(대출금리 − 예금금리)이 넓어져 이익이 는다. 너무 오르면 연체가 늘어 되돌아온다.",
      "watch": "순이자마진(NIM) · 대출 성장률 · 연체율 · 주주환원"
    },
    "insur": {
      "what": "보험료를 받아 채권으로 굴린다. 금리가 오르면 운용수익과 자본비율(K-ICS)이 좋아진다.",
      "watch": "국고채 10년 · K-ICS 비율 · 보험계약마진(CSM)"
    },
    "semi": {
      "what": "이익이 먼 미래에 크게 잡히는 성장주. 미 10년물이 오르면 할인율이 커져 눌리고, 내리면 가장 먼저 뛴다. 수출주이기도 해서 달러 강세는 ± 로 갈린다.",
      "watch": "미 10년물 · 메모리 가격 · 원/달러 · 외국인 순매수"
    },
    "bio": {
      "what": "이익이 아직 없거나 먼 회사가 많아 금리에 가장 민감한 성장주. 금리가 내리면 자금 조달이 쉬워진다.",
      "watch": "미 10년물 · 임상 일정 · 바이오 자금 조달"
    },
    "auto": {
      "what": "달러로 파는 수출주. 원화가 약해지면 환차익 · 가격 경쟁력이 생기고, 금리가 오르면 할부 수요가 눌린다.",
      "watch": "원/달러 · 미국 판매 · 관세 · 할부금리"
    },
    "ship": {
      "what": "달러로 수주하는 수출주. 환율 수혜에 더해 유가가 오르면 해양플랜트 · LNG선 발주가 는다.",
      "watch": "원/달러 · 신조선가 · 수주 잔고 · 유가"
    },
    "refine": {
      "what": "원유를 사서 석유제품을 판다. 유가가 오르면 재고 평가이익 · 정제마진이 늘고, 급하게 내리면 거꾸로 받는다.",
      "watch": "정제마진 · 유가 · 재고 평가손익 · 원/달러"
    },
    "chem": {
      "what": "나프타(원유 부산물)가 원가라 유가가 오르면 원가가 오르고, 제품 가격이 못 따라가면 마진이 눌린다.",
      "watch": "나프타 가격 · 에틸렌 스프레드 · 중국 수요"
    },
    "air": {
      "what": "연료비가 가장 큰 비용이고 항공기 리스 · 부채가 달러다. 유가와 달러가 같이 오르면 둘 다 받는다.",
      "watch": "항공유 · 원/달러 · 여객 수요 · 환헤지 비율"
    },
    "sea": {
      "what": "연료비는 유가로 받지만 운임은 달러로 받는다. 탱커는 유가 · 지정학에 따라 운임이 뛰어 ± 로 갈린다.",
      "watch": "운임지수(SCFI · BDI) · 벙커유 · 원/달러"
    },
    "constr": {
      "what": "금리가 오르면 주택 수요 · PF 조달이 눌리고, 유가가 오르면 자재비가 는다. 금리가 내릴 때 먼저 받는 내수주.",
      "watch": "국고채 · 주택담보대출 금리 · 분양 · PF 연체"
    },
    "util": {
      "what": "연료(유가 · 가스)를 사서 전기 · 가스를 판다. 요금은 정부가 정해 원가를 바로 못 넘기고, 부채가 커서 금리에도 받는다.",
      "watch": "유가 · LNG 가격 · 전기 · 가스 요금 조정 · 국고채"
    }
  },
