  "info": {
    "demand": {
      "what": "아시아에서 유럽으로 가는 화물. 이 양이 늘어야 북쪽으로 돌릴 배가 생긴다.",
      "watch": "아시아–유럽 컨테이너 운임 · 수에즈 통항량"
    },
    "dist": {
      "what": "부산에서 로테르담까지 북쪽으로 가면 수에즈 경유보다 짧다. 운항일과 연료가 줄어 선사가 관심을 갖는 이유다.",
      "watch": "해빙 면적 · 통항 가능 기간(여름)"
    },
    "lngx": {
      "what": "러시아가 북극 가스를 아시아로 팔려는 수요. 북동항로를 실제로 쓰는 가장 큰 화물이 LNG 다.",
      "watch": "야말 LNG 출하 · 북극 LNG 2 제재 · 중국 · 인도 도입"
    },
    "nsr": {
      "what": "러시아 북쪽 해안을 따라 베링해협에서 바렌츠해까지 가는 길. 여름에만 열리고 러시아 영해 · 배타적경제수역을 지난다.",
      "watch": "통항 건수 · 통항 가능 기간 · 결빙 시점",
      "choke": "한 나라가 쥔다 — 러시아 영해를 지나므로 러시아가 열고 닫는다"
    },
    "permit": {
      "what": "북동항로를 지나려면 러시아 당국(로사톰이 운영)의 허가와 쇄빙선 호위가 필요하다.",
      "watch": "허가 건수 · 호위 요금 · 제재 범위",
      "choke": "허가 한 곳 — 러시아가 안 내주면 배가 못 간다"
    },
    "insur": {
      "what": "결빙 해역은 사고 위험이 커서 선체 · P&I 보험료가 비싸고, 제재 대상이면 보험을 안 받아 준다.",
      "watch": "보험 할증 · 제재 목록 · 사고 건수",
      "choke": "소수 보험사 — 보험이 안 나오면 배가 못 뜬다"
    },
    "lngc": {
      "what": "얼음을 깨며 LNG 를 싣는 Arc7 등급 운반선. 야말 LNG 선단은 옛 대우조선해양(지금 한화오션)이 지었다.",
      "watch": "북극 LNG 2 선단 발주 · 제재로 인도 중단된 배"
    },
    "icecont": {
      "what": "얼음 바다를 다닐 수 있게 선체를 보강한 컨테이너선. 아직 수가 적고 정기 노선은 시험 단계다.",
      "watch": "선사 시험 운항 · 내빙 선박 발주"
    },
    "icebreaker": {
      "what": "핵추진 쇄빙선으로 앞길을 뚫는다. 러시아 로사톰플로트만 갖고 있다.",
      "watch": "신조 쇄빙선 취항 · 호위 가능 척수",
      "choke": "한 회사 — 쇄빙선 수가 곧 통항 상한이다"
    },
    "yard": {
      "what": "쇄빙 LNG선 · 내빙선을 지을 수 있는 국내 조선 3사. 극지 선박은 고가라 수주 하나가 크다.",
      "watch": "극지선 수주 공시 · 러시아 제재로 묶인 계약"
