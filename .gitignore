# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# 에디터/IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code 로컬 설정 — 개인 것이라 공유하지 않는다
# (디렉토리째 무시하면 안쪽을 되살릴 수 없어서 `.claude/*` 로 적는다)
.claude/*
# 단, 슬래시 커맨드는 세 세션과 두 PC 가 함께 쓰므로 저장소에 둔다
!.claude/commands/

# API 키 (절대 커밋 금지) — 한국투자증권 앱키, OpenDART 인증키 등
secrets.json
**/secrets.json
.env
**/.env
*.key
.kis-token-cache.json
**/.kis-token-cache.json

# 레거시 백업 (확인 후 수동 삭제)
_legacy-*.html.bak

# 로그
*.log

# 파이썬 캐시
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Node (혹시 모를 상황 대비)
node_modules/
npm-debug.log*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
