# thekjc.co.kr 앞문 — 아이디 · 비밀번호(basic_auth) · 2026-11-04 재권님 「비밀번호로 해줘」
# 맥미니가 SSH 로 걸어 둔 통로(127.0.0.1:18764 → 맥미니 메인 8764)로 넘긴다 · 2026-11-04 · 틀린 비밀번호는 fail2ban(caddy-thekjc)
{
	email contact@kjcstudio.kr
}

www.thekjc.co.kr {
	redir https://thekjc.co.kr{uri} permanent
}

# 옛 주소 — 2026-11-05 재권님 「가비아 길로 돌리」 · Cloudflare DNS 가 이 서버를 가리키면(프록시 끔) 인증서를 스스로 받는다
www.thekjcstudio.com {
	redir https://thekjcstudio.com{uri} permanent
}

thekjc.co.kr, thekjcstudio.com {
	log {
		output file /var/log/caddy/thekjc-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}
	basic_auth {
		thekjc <비밀번호 해시 — caddy hash-password 로 만든다 · 저장소에 두지 않는다>
	}
	reverse_proxy 127.0.0.1:18764 {
		header_up -Authorization
	}
}
