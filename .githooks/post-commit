#!/bin/sh
# 룰 문서를 커밋했으면 **다른 세션에 전파하라고** 알린다.
#
# `CLAUDE.md` 는 세션이 **시작할 때** 읽힌다. 이미 돌고 있는 세션은 바뀐 내용을
# 모르고, 아침에 읽은 문서대로 계속 일한다.
#
# 2026-09-17 하루에 `CLAUDE.md` 가 **13번** 바뀌었다. 하위 작업자 룰(cab2702)을
# 넣었을 때 네 세션이 다 몰랐고, 따로 알린 뒤에야 움직였다.
#
# 커밋을 막지 않는다. 알리기만 한다 — 전파는 사람이 판단할 일이고,
# 룰이 안 바뀐 커밋까지 붙잡아 두면 안 된다.

# `--root` 가 있어야 **저장소의 첫 커밋**에서도 목록이 나온다. 부모가 없는 커밋은
# 비교 대상이 없어서 빈 결과를 준다 (2026-09-17 실측). 이 저장소는 첫 커밋이
# 지났지만, **worktree 로 새 체크아웃을 만들면** 그 자리가 다시 온다.
files=$(git diff-tree --root --no-commit-id --name-only -r HEAD 2>/dev/null)

# ── 화면 파일을 고쳤으면 칸 크기를 재보라고 알린다 ──────────────────
#
# 「보는 것을 바꿔도 자리는 그대로다」 가 룰인데 검사가 없어서 세 번 재발했다
# (차트 · 투자자 정보 · 첫 화면). 2026-09-21 에 재권님이 "뭐 수정할때마다
# 창 크기 바뀌는데 재발 안하게좀 해" 라고 하셨다.
#
# **여기서 돌리지는 않는다.** 크롬을 띄워 네 화면을 재는 데 1분 넘게 걸리고,
# 8765(holdings 미리보기) 가 떠 있어야 한다. 커밋을 그만큼 붙잡아 둘 수 없다.
layout=$(printf '%s\n' "$files" | grep -E '^holdings/.*\.(css|html|js)$')
if [ -n "$layout" ]; then
  echo ""
  echo "  ── 화면 파일을 고쳤습니다 ─────────────────────────────"
  printf '%s\n' "$layout" | head -5 | sed 's/^/      /'
  echo ""
  echo "  칸 크기가 바뀌었을 수 있습니다. 재서 대보십시오."
  echo ""
  echo "      python tools/check-layout.py"
  echo ""
  echo "  바뀐 것이 맞으면  --save  로 기준을 다시 잡습니다."
  echo "  ──────────────────────────────────────────────────────"
  echo ""
fi

changed=$(printf '%s\n' "$files" |
          grep -E '^(CLAUDE\.md|holdings/CLAUDE\.md|\.claude/commands/)')
[ -z "$changed" ] && exit 0

echo ""
echo "  ── 룰 문서가 바뀌었습니다 ─────────────────────────────"
printf '%s\n' "$changed" | sed 's/^/      /'
echo ""
echo "  다른 세션은 아직 이 변경을 모릅니다. CLAUDE.md 는 세션이"
echo "  **시작할 때** 읽히기 때문입니다."
echo ""
echo "  돌고 있는 세션에 알리십시오 — 무엇이 바뀌었는지와 함께."
echo "  받는 쪽은 그 부분을 다시 읽습니다."
echo "  ──────────────────────────────────────────────────────"
echo ""

# 세션 폴더들은 `staging` 에서 받는다. **`main` 에 직접 올린 문서는 누가
# 내려보내지 않으면 거기까지 안 간다.** 「staging 도 두 번 받는다」 는
# 「작업 시작 전 · 올리기 직전」 인데, 문서 레인이 main 에 직접 올리는
# 동안에는 **그 두 시점이 안 온다.** 아무도 안 보는 구간이 생긴다.
#
# 2026-09-21 에 네 번 났다. 「staging 에서 받으십시오」 라고 말해도
# staging 자체가 뒤처져 있으면 받을 것이 없다.
#
# **브랜치가 main 일 때만 띄운다.** 이 훅은 어느 워크트리에서든 도는데,
# kjc-staging 이나 세션 폴더에서 커밋할 때도 뜨면 헛경보가 된다.
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "  ── staging 에도 내려보내야 합니다 ─────────────────────"
  echo ""
  echo "  세션 폴더들은 staging 에서 받습니다. main 에만 있으면"
  echo "  **거기까지 안 갑니다** — 「받으십시오」 라고 말해도"
  echo "  받을 것이 없습니다."
  echo ""
  echo "  홈페이지_정리 자리입니다. 알리십시오."
  echo ""
  echo "      git log --oneline staging..main | wc -l"
  echo "  ──────────────────────────────────────────────────────"
  echo ""
fi
exit 0
