#!/bin/sh
# 룰 문서를 커밋했으면 **다른 세션에 전파하라고** 알린다.
#
# `CLAUDE.md` 는 세션이 **시작할 때** 읽힌다. 이미 돌고 있는 세션은 바뀐 내용을
# 모르고, 아침에 읽은 문서대로 계속 일한다.
#
# 2026-09-17 하루에 `CLAUDE.md` 가 **13번** 바뀌었다. 하위 작업자 룰(cab2702)을
# 넣었을 때 네 세션이 다 몰랐고, 따로 알린 뒤에야 움직였다.
#
# 커밋을 막지 않는다. 알리기만 한다 — 전파는 사람이 판단할 일이고,
# 룰이 안 바뀐 커밋까지 붙잡아 두면 안 된다.

# `--root` 가 있어야 **저장소의 첫 커밋**에서도 목록이 나온다. 부모가 없는 커밋은
# 비교 대상이 없어서 빈 결과를 준다 (2026-09-17 실측). 이 저장소는 첫 커밋이
# 지났지만, **worktree 로 새 체크아웃을 만들면** 그 자리가 다시 온다.
files=$(git diff-tree --root --no-commit-id --name-only -r HEAD 2>/dev/null)

# ── 화면 파일을 고쳤으면 칸 크기를 재보라고 알린다 ──────────────────
#
# 「보는 것을 바꿔도 자리는 그대로다」 가 룰인데 검사가 없어서 세 번 재발했다
# (차트 · 투자자 정보 · 첫 화면). 2026-09-21 에 재권님이 "뭐 수정할때마다
# 창 크기 바뀌는데 재발 안하게좀 해" 라고 하셨다.
#
# **여기서 돌리지는 않는다.** 크롬을 띄워 네 화면을 재는 데 1분 넘게 걸리고,
# 8765(holdings 미리보기) 가 떠 있어야 한다. 커밋을 그만큼 붙잡아 둘 수 없다.
# **`worker/` 와 `server/` 는 화면이 아니다 (2026-09-23).**
#
# `.js` 라는 이유로 `holdings/worker/kis-worker.js` 가 걸려서, 워커만
# 고친 커밋에도 「칸 크기를 재 보십시오」 가 떴다. **헛경보가 나면
# 진짜 경보도 같이 무시하게 된다.**
#
# `server/` 도 함께 뺀다 — 그 안의 `.py` 는 원래 안 걸리지만,
# 나중에 `.js` 가 생기면 같은 일이 난다.
layout=$(printf '%s\n' "$files" |
         grep -E '^holdings/.*\.(css|html|js)$' |
         grep -vE '^holdings/(worker|server)/')
if [ -n "$layout" ]; then
  echo ""
  echo "  ── 화면 파일을 고쳤습니다 ─────────────────────────────"
  printf '%s\n' "$layout" | head -5 | sed 's/^/      /'
  echo ""
  echo "  칸 크기가 바뀌었을 수 있습니다. 재서 대보십시오."
  echo ""
  echo "      python tools/check-layout.py"
  echo ""
  echo "  바뀐 것이 맞으면  --save  로 기준을 다시 잡습니다."
  echo "  ──────────────────────────────────────────────────────"
  echo ""
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  # **알리지 말고 그 자리에서 내린다 (2026-09-21).** 전에는 「알리십시오」
  # 라고만 띄웠는데, **그 훅은 커밋한 사람 화면에 뜨고 알리는 것은 여전히
  # 사람이었다.** 같은 날 세 번 샜고 세 번 다 받아가는 세션이 재서 알았다.
  #
  # `--ff-only` 라 판단이 없다. staging 에 따로 쌓인 것이 있으면 **그냥
  # 멈춘다** — 남의 작업을 덮을 수가 없다. 멈추면 사람이 보면 된다.
  #
  # 폴더는 worktree 목록에서 찾는다. 경로를 박으면 PC 마다 낡는다.
  sdir=$(git worktree list --porcelain 2>/dev/null |
         awk '/^worktree /{w=substr($0,10)} /^branch refs\/heads\/staging$/{print w}')
  echo ""
  if [ -n "$sdir" ] && [ -d "$sdir" ]; then
    # 실패 이유를 버리지 않는다. 2026-09-21 에 두 번 막혔는데 둘 다
    # `debugging/latest.json` 이 그쪽 워크트리에서 미커밋이라 그랬다 —
    # `check.py` 를 돌릴 때마다 바뀌는 파일이다. 이유를 안 보여주면
    # 「staging 에 뭔가 쌓였나」 를 매번 뒤지게 된다.
    # **환경변수를 지우고 부른다.** 훅은 `GIT_DIR` · `GIT_INDEX_FILE` 을
    # 물려받는데, 그 상태로 다른 워크트리를 건드리면 **이 저장소의 인덱스를
    # 그쪽 것으로 알고** 엉뚱한 자리에 락을 만들려 한다.
    #
    #     error: Unable to create '…/kjc-staging/.git/index.lock':
    #            No such file or directory
    #
    # 2026-09-21 에 세 번 막혔다. 처음엔 「staging 에 뭔가 쌓였나」 로 봤고,
    # 다음엔 「커밋 직후라 락이 걸렸나」 로 봤다. **둘 다 틀렸다** —
    # 실패 이유를 버리지 않게 고친 그 자리에서 진짜 원인이 나왔다.
    err=$(env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX           git -C "$sdir" merge main --ff-only 2>&1)
    if [ $? -eq 0 ]; then
      echo "  ── staging 에도 내렸습니다 (fast-forward) ─────────────"
      echo "     세션 폴더들이 이제 받을 수 있습니다."
    else
      echo "  ── staging 에 못 내렸습니다 ───────────────────────────"
      echo ""
      printf '%s
' "$err" | head -4 | sed 's/^/      /'
      echo ""
      echo "  **홈페이지_정리 자리입니다. 알리십시오.**"
      echo ""
      echo "      git log --oneline staging..main | wc -l"
    fi
  else
    echo "  ── staging 폴더를 못 찾았습니다 ───────────────────────"
    echo "  홈페이지_정리에 알리십시오."
  fi
  echo "  ──────────────────────────────────────────────────────"
  echo ""
fi

changed=$(printf '%s\n' "$files" |
          grep -E '^(CLAUDE\.md|holdings/CLAUDE\.md|\.claude/commands/)')
[ -z "$changed" ] && exit 0

echo ""
echo "  ── 룰 문서가 바뀌었습니다 ─────────────────────────────"
printf '%s\n' "$changed" | sed 's/^/      /'
echo ""
echo "  다른 세션은 아직 이 변경을 모릅니다. CLAUDE.md 는 세션이"
echo "  **시작할 때** 읽히기 때문입니다."
echo ""
echo "  돌고 있는 세션에 알리십시오 — 무엇이 바뀌었는지와 함께."
echo "  받는 쪽은 그 부분을 다시 읽습니다."
echo "  ──────────────────────────────────────────────────────"
echo ""

# 세션 폴더들은 `staging` 에서 받는다. **`main` 에 직접 올린 문서는 누가
# 내려보내지 않으면 거기까지 안 간다.** 「staging 도 두 번 받는다」 는
# 「작업 시작 전 · 올리기 직전」 인데, 문서 레인이 main 에 직접 올리는
# 동안에는 **그 두 시점이 안 온다.** 아무도 안 보는 구간이 생긴다.
#
# 2026-09-21 에 네 번 났다. 「staging 에서 받으십시오」 라고 말해도
# staging 자체가 뒤처져 있으면 받을 것이 없다.
#
# **브랜치가 main 일 때만 띄운다.** 이 훅은 어느 워크트리에서든 도는데,
# kjc-staging 이나 세션 폴더에서 커밋할 때도 뜨면 헛경보가 된다.
# ── 진행 알림 ──────────────────────────────────────────────────
#
# 「셋은 모든 진행사항을 공유받는다」 의 약점이 **예고대로 났다.**
# 그 절에 「당장 풀 방법은 없다. 적어 두는 것은 **나중에 훅으로 옮길
# 자리**를 표시해 두는 것이다」 라고 적혀 있었다.
#
# 2026-09-22 에 하루 세 번 빠졌다 — 완료·커밋이 창구에만 간 것,
# 재권님께 직접 받은 푸시 지시를 안 알린 것, 남의 커밋이 함께 올라간 것.
# **알림은 빠져도 아무 신호가 없다.** 그래서 신호를 여기 만든다.
#
# **막지 않는다.** 알릴지는 사람이 판단할 일이다.
echo ""
echo "  ── 진행 알림 ──────────────────────────────────────────"
echo "     이 커밋을 \`작업우선순위\` 에 알리셨습니까"
echo ""
echo "     묻는 것 · 검수   ->  홈페이지_정리"
echo "     진행 알림        ->  작업우선순위"
echo "  ──────────────────────────────────────────────────────"

exit 0
