#!/bin/sh
# 올리기 **전에** 무엇이 함께 가는지 보여준다.
#
# 2026-09-22 에 `홈페이지_정리` 가 카드 띠 커밋을 올렸는데 `개념정의` 의
# 커밋이 `main` 에 먼저 있어 **딸려 갔다.** 「남의 커밋이 함께 올라갔으면
# 그 세션에 알린다」 는 룰이 있었는데 **아무 신호가 없어** 늦게 알렸다.
#
# `post-commit` 은 이것을 못 잡는다 — **푸시는 커밋 자리가 아니다.**
# 그래서 자리를 둘로 나눴다.
#
#     커밋 뒤 (post-commit)   이 커밋을 작업우선순위에 알리셨습니까
#     푸시 전 (pre-push)      **남의 레인 커밋 N건이 함께 갑니다**
#
# `post-push` 라는 훅은 git 에 없다. `pre-push` 는 **무엇이 올라갈지를
# stdin 으로 받아** 올리기 전에 셀 수 있어 오히려 낫다.
#
# 설치 (PC 마다 한 번):
#     git config core.hooksPath .githooks
#
# **막지 않는다.** 알릴지는 사람이 판단할 일이다.
#
# stdin 형식:  <로컬 ref> <로컬 sha> <원격 ref> <원격 sha>
# 새 브랜치면 원격 sha 가 0 으로 채워지고, 지우는 것이면 로컬 sha 가 그렇다.

ZERO="0000000000000000000000000000000000000000"
shown=0

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue        # 브랜치를 지우는 것

  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"                          # 원격에 없던 브랜치
  else
    range="$remote_sha..$local_sha"
  fi

  count=$(git log --oneline "$range" 2>/dev/null | wc -l | tr -d ' ')
  [ "$count" = "0" ] && continue

  # 레인을 센다. `pre-commit` 과 같은 기준이다 — 세션 이름이 아니라
  # **레인 이름**으로 센다 (주식 세션 넷이 holdings/ 를 함께 쓴다).
  lanes=$(git log --format='' --name-only "$range" 2>/dev/null |
    grep '/' |
    awk -F/ '
      $NF == "CLAUDE.md"                   { print "개념정의"; next }
      $0  == "assets/css/theme.css"        { next }
      $1 == "kjcEngine" || $1 == "ai-work" { print "엔진_개발"; next }
      $1 == "holdings"                     { print "주식"; next }
      $1 == "projects"                     { print "작업우선순위"; next }
      $1 == "debugging"                    { print "개념정의"; next }
      $1 == ".claude" && $2 == "commands"  { print "홈페이지_정리"; next }
      $1 == "company-setup" || $1 == "api-board" { print "홈페이지_정리"; next }
      $1 == "assets" || $1 == "partials" || $1 == "data" || $1 == "category" \
                                           { print "홈페이지_정리"; next }
      $1 == "tools" || $1 == ".githooks" || $1 == ".claude" { print "개념정의"; next }
    ' | sort -u)

  lane_count=$(printf '%s\n' "$lanes" | grep -c '[^[:space:]]')

  shown=1
  echo ""
  echo "  ── 올라갑니다 — 커밋 $count 건 ────────────────────────"
  git log --oneline "$range" 2>/dev/null | head -8 | sed 's/^/     /'
  [ "$count" -gt 8 ] && echo "     … 그 밖 $((count - 8))건"

  if [ "$lane_count" -gt 1 ]; then
    echo ""
    echo "     **레인이 $lane_count 개 섞여 있습니다** —"
    printf '%s\n' "$lanes" | grep '[^[:space:]]' | sed 's/^/        /'
    echo ""
    echo "     남의 것이 함께 가면 **그 세션에 알립니다.** 올린 쪽이 알립니다."
    echo "     워커가 담겼으면 **배포가 필요하다는 것까지** 함께 전합니다."
  fi

  # 워커가 담겼나. 담겼으면 푸시만으로는 아무 일도 안 일어난다.
  workers=$(git log --format='' --name-only "$range" 2>/dev/null |
            grep 'worker/.*\.js' | sort -u)
  if [ -n "$workers" ]; then
    echo ""
    echo "     **워커가 담겼습니다** — 푸시만으로는 반영되지 않습니다."
    printf '%s\n' "$workers" | sed 's/^/        /'
    echo "     재권님이 Cloudflare 대시보드에 붙여넣으셔야 합니다."
  fi

  echo "  ──────────────────────────────────────────────────────"
done

if [ "$shown" = "1" ]; then
  echo ""
  echo "     푸시 지시를 받으셨습니까. 받은 답은 \`작업우선순위\` 에도 알립니다."
  echo ""
fi

exit 0
