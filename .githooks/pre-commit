#!/bin/sh
# 커밋에 여러 구역이 섞였으면 멈춘다.
#
# 세션 다섯이 작업 폴더 하나를 함께 쓴다. 장바구니(인덱스)도 하나라,
# 내 경로만 담아도 남이 미리 담아둔 것이 함께 올라간다.
# 실제로 projects/ 가 남의 커밋에 딸려 들어갈 뻔했고, 그때는 사람이 눈으로 잡았다.
#
# 설치 (PC 마다 한 번):
#     git config core.hooksPath .githooks
#
# 막지 않는 경우:
#   - 한 구역만 있을 때
#   - 구역 밖 파일(README 등)만 있을 때
#   - 판단이 애매할 때 — 통과시킨다. 막아서 작업이 서는 쪽이 더 나쁘다
#
# 정당하게 섞어야 하면 (예: 레인 표와 그 구역 코드를 함께 고칠 때):
#     git commit --no-verify
#
# 이것은 자물쇠가 아니라 걸림돌이다. 우회할 수 있고, 우회해도 된다.
# 다만 우회하려면 한 번 더 생각하게 된다.

files=$(git diff --cached --name-only)
[ -z "$files" ] && exit 0

areas=$(printf '%s\n' "$files" | awk -F/ '
  $1 == "holdings"      { print "holdings";      next }
  $1 == "projects"      { print "projects";      next }
  $1 == "company-setup" { print "company-setup"; next }
  $1 == "api-board"     { print "api-board";     next }
  $1 == "debugging"     { print "debugging";     next }
' | sort -u)

# 구역에 안 걸리는 파일(루트 문서 등)만 담긴 커밋은 여기서 끝난다.
# `grep -c` 로 세다가 빈 입력에서 "0" 을 출력하고 exit 1 을 내는 바람에
# `|| echo 0` 이 덧붙어 "0\n0" 이 되었고, 정상 커밋이 전부 막혔다.
# 시험하지 않았으면 그대로 들어갔을 버그다 (2026-09-17).
[ -z "$areas" ] && exit 0

count=$(printf '%s\n' "$areas" | wc -l | tr -d ' ')
[ "$count" -le 1 ] && exit 0

echo ""
echo "  커밋을 멈췄습니다 — 한 커밋에 구역이 $count 개 섞여 있습니다."
echo ""
printf '%s\n' "$areas" | while read -r a; do
  [ -z "$a" ] && continue
  echo "    [$a]"
  printf '%s\n' "$files" | grep "^$a/" | sed 's/^/        /'
done
echo ""
echo "  구역마다 맡은 세션이 다릅니다 (CLAUDE.md 「세션 역할 분담」)."
echo "  남의 작업이 딸려 들어가는 중일 수 있습니다."
echo ""
echo "  자기 것만 담으려면:"
echo "      git restore --staged <남의 경로>     내용은 그대로 남습니다"
echo "      git commit -- <내 경로>              장바구니를 건너뜁니다"
echo ""
echo "  일부러 섞는 것이면:"
echo "      git commit --no-verify"
echo ""
exit 1
