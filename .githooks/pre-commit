#!/bin/sh
# 한 커밋에 **레인 두 개 이상**이 섞였으면 멈춘다.
#
# 세션 다섯이 작업 폴더 하나를 함께 쓴다. 장바구니(인덱스)도 하나라,
# 내 경로만 담아도 남이 미리 담아둔 것이 함께 올라간다.
#
# 설치 (PC 마다 한 번):
#     git config core.hooksPath .githooks
#
# 구역이 아니라 **레인**으로 센다 (2026-09-17).
# 처음에는 holdings·projects 같은 구역만 셌는데, 첫 실전에서 `temp/README.md`
# 가 남의 장바구니에서 딸려 들어왔다. 목록에 없는 폴더라 세지 않았다.
# 지금은 목록에 없는 최상위 폴더도 `(미정)` 이라는 한 레인으로 묶어서 센다.
#
# 같은 레인의 여러 폴더를 함께 고치는 것은 정상이므로 통과한다
# (예: tools/ 와 .claude/ 는 둘 다 개념정의).
#
# 정당하게 섞어야 하면:
#     git commit --no-verify
#
# 자물쇠가 아니라 걸림돌이다. 우회할 수 있고, 우회해도 된다.
# 다만 우회하려면 한 번 더 생각하게 된다.

files=$(git diff --cached --name-only)
[ -z "$files" ] && exit 0

# ── 룰 검사 ────────────────────────────────────────────────────
#
# `CLAUDE.md` 의 「아직 검사가 없는 룰」 을 한 번에 센다. 검사 방법은
# 문서에 적혀 있었는데 **돌리는 사람이 없어서 안 돌았다** — 2026-09-22 에
# 재권님이 「룰 안지키는거 감시안함?」 하고 물으셔서 여기로 옮겼다.
#
# **기억해야 지켜지는 룰은 지켜지지 않는다.** 문서가 스스로 그렇게
# 적어 놓고 그 상태였다.
#
# 2026-09-22 실측 **121ms** 라 커밋을 눈에 띄게 늦추지 않는다.
#
# 종료코드는 도구가 셋으로 낸다.
#     0  걸린 것 없음 — 또는 **「봐야 할 자리」 만 있다** (막지 않는다)
#     1  위반 — **막는다**
#     2  못 쟀다 — 알리고 **통과시킨다**
#
# **「봐야 할 자리」 로 막지 않는 것이 핵심이다.** 그날 「자세히 ›」 둘이
# 걸렸는데 **둘 다 이미 모달을 열고 있었다**(JS 가 가로챈다). 막았으면
# 멀쩡한 커밋이 멈췄을 것이다.
RULES="$(git rev-parse --show-toplevel 2>/dev/null)/tools/check-rules.py"
if [ -f "$RULES" ] && command -v python >/dev/null 2>&1; then
  rules_out=$(python "$RULES" 2>&1)
  rules_code=$?
  if [ "$rules_code" = "1" ]; then
    echo ""
    echo "  커밋을 멈췄습니다 — 룰 검사에 걸렸습니다."
    echo ""
    printf '%s
' "$rules_out" | sed 's/^/  /'
    echo ""
    echo "  고치고 다시 커밋하십시오. 일부러 넘기려면:"
    echo "      git commit --no-verify"
    echo ""
    exit 1
  fi
  if [ "$rules_code" = "2" ]; then
    echo ""
    echo "  ── 룰 검사가 일부를 못 쟀습니다 (커밋은 계속합니다) ──"
    printf '%s
' "$rules_out" | sed 's/^/  /'
    echo ""
  fi
fi


# 경로 → 레인. CLAUDE.md 「세션 역할 분담」 표를 따른다.
# 루트 파일(CLAUDE.md 등)은 어느 레인도 아니므로 세지 않는다.
lanes=$(printf '%s\n' "$files" | awk -F/ '
  NF < 2 { next }                                   # 루트 파일은 건너뛴다

  # 룰 문서는 어느 폴더에 있든 개념정의다 (2026-09-17 담당 변경).
  # 이 줄이 없으면 `holdings/CLAUDE.md` 가 주식페이지_개발로 잡혀서,
  # 룰 문서 둘을 함께 고친 커밋이 「레인이 섞였다」 고 막힌다.
  # `docs/*.md` 는 여기 넣지 않는다 — 그쪽은 각 레인이 직접 쓴다.
  $NF == "CLAUDE.md"                    { print "개념정의";        next }

  # **`theme.css` 는 레인을 정하지 않는다 (2026-09-22).** 한 파일에 여섯 구역
  # 변수가 함께 있어서 **경로로는 못 나눈다.** `--kh-` 만 고쳐도 경로가
  # `assets/` 라 홈페이지_정리로 잡히고, 주식 파일과 함께 커밋하면 막혔다 —
  # 우회(`--no-verify`)가 일곱 번 났다.
  #
  # **diff 의 접두사로 가르는 것은 비쌌다.** 여러 줄 주석 안의
  # `` `--cs-danger` `` 까지 세어져서 줄 단위 grep 으로는 안 갈린다 (실측).
  #
  # **함께 담긴 파일이 정하게 둔다.** 실측으로 그 커밋 여덟이 전부 갈렸다 —
  # `assets`+`holdings` 다섯 · `assets` 만 둘 · `assets`+`partials` 하나.
  # 이 파일만 담긴 커밋은 레인이 0 이 되어 그냥 지나간다. 섞인 것이 없어서다.
  $0 == "assets/css/theme.css"          { next }

  # 2026-09-21 에 넷이 통째로 옮겨 갔다. `스케줄_툴개발` 이 `주식페이지_개발3`
  # 으로 바뀌면서 업무가 `holdings/` 가 되어, 들고 있던 넷이 주인을 잃었다.
  # **세션 이름이 아니라 레인 이름으로 센다** — 주식 세션이 넷이라 이름으로
  # 세면 같은 레인이 넷으로 갈린다.
  $1 == "kjcEngine" || $1 == "ai-work"  { print "엔진_개발";      next }

  $1 == "holdings"                      { print "주식";           next }
  $1 == "projects"                      { print "작업우선순위";   next }
  $1 == "debugging"                     { print "개념정의";        next }

  $1 == ".claude" && $2 == "commands"   { print "홈페이지_정리";   next }
  $1 == "assets" || $1 == "category" ||
  $1 == "data"   || $1 == "partials" ||
  $1 == "company-setup" || $1 == "api-board" { print "홈페이지_정리"; next }

  $1 == "tools" || $1 == ".claude" ||
  $1 == ".githooks" || $1 == "docs"     { print "개념정의";        next }

  { print "(미정) " $1 }                            # 그 밖의 최상위 폴더
' | sort -u)

# 레인에 걸리는 것이 없으면(루트 문서만 담긴 커밋) 그냥 지나간다.
#
# 여기서 예전에 사고가 났다. `grep -c .` 로 셌는데, grep 은 빈 입력에서
# **"0" 을 출력하고 종료코드 1** 을 낸다. 거기에 `|| echo 0` 을 붙여 두어
# 결과가 "0\n0" 이 되었고, `[ "0\n0" -le 1 ]` 이 숫자가 아니라 오류가 났다.
# `[` 가 오류를 내면 거짓으로 취급되므로 **통과해야 할 커밋이 전부 막혔다.**
# 그리고 그 경우가 가장 흔했다 — 루트 문서 한 장만 고치는 커밋이다.
[ -z "$lanes" ] && exit 0

count=$(printf '%s\n' "$lanes" | wc -l | tr -d ' ')
[ "$count" -le 1 ] && exit 0

echo ""
echo "  커밋을 멈췄습니다 — 한 커밋에 레인이 $count 개 섞여 있습니다."
echo ""
printf '%s\n' "$lanes" | while IFS= read -r lane; do
  [ -z "$lane" ] && continue
  echo "    [$lane]"
  case "$lane" in
    "(미정) "*) dir=${lane#"(미정) "} ;;
    "주식")           dir="holdings" ;;
    "작업우선순위")   dir="projects" ;;
    *) dir="" ;;
  esac
  if [ -n "$dir" ]; then
    printf '%s\n' "$files" | grep "^$dir/" | sed 's/^/        /'
  else
    printf '%s\n' "$files" | grep "/" | sed 's/^/        /'
  fi
done
echo ""
echo "  레인마다 맡은 세션이 다릅니다 (CLAUDE.md 「세션 역할 분담」)."
echo "  남의 작업이 딸려 들어가는 중일 수 있습니다."
echo ""
echo "  자기 것만 담으려면:"
echo "      git restore --staged <남의 경로>     내용은 그대로 남습니다"
echo "      git commit -- <내 경로>              장바구니를 건너뜁니다"
echo ""
echo "  일부러 섞는 것이면:"
echo "      git commit --no-verify"
echo ""
exit 1
