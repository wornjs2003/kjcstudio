{
  "permissions": {
    "deny": [
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git stage -A*)",
      "Bash(git stage .)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean --force*)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(./install.command 8765*)",
      "Bash(launchd/install.command 8765*)",
      "Bash(./install.command)",
      "Bash(launchd/install.command)",
      "Bash(rm /Users/kjc/work/KJCStudio/holdings/market.db*)",
      "Bash(rm -f /Users/kjc/work/KJCStudio/holdings/market.db*)",
      "Bash(rm -rf /Users/kjc/work/KJCStudio/holdings/data*)",
      "Bash(launchctl kickstart -k gui/501/kr.kjcstudio.kis-proxy)",
      "Bash(launchctl bootout gui/501/kr.kjcstudio.kis-proxy)",
      "Bash(launchctl unload ~/Library/LaunchAgents/kr.kjcstudio.kis-proxy.plist)",
      "Bash(launchctl bootout gui/501 ~/Library/LaunchAgents/kr.kjcstudio.kis-proxy.plist)",
      "Bash(./install.command 8764*)",
      "Bash(launchd/install.command 8764*)",
      "Bash(launchctl kickstart -k gui/501/kr.kjcstudio.service-8764)",
      "Bash(launchctl bootout gui/501/kr.kjcstudio.service-8764)",
      "Bash(rm /Users/kjc/service/holdings/market.db*)",
      "Bash(rm -f /Users/kjc/service/holdings/market.db*)",
      "Bash(rm -rf /Users/kjc/service/holdings/data*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-edit-churn.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-board-card.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-main-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-mockup.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-sendmessage-addr.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-subagent-ask.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-view-size.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-session-start.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KJC_KOREAN_HOOK=block sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-korean.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "KJC_LINK_HOOK=block sh \"$(git rev-parse --show-toplevel)/.claude/run-py.sh\" \"$(git rev-parse --show-toplevel)/tools/hook-link-path.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
