<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KJC_ROLE</key>
		<string>server</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>kr.kjcstudio.kis-proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<!-- **`-u` 가 없으면 로그가 늦게 쓰인다** — 다른 plist 주석 참고 -->
		<string>-u</string>
		<string>server/kis_proxy.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/kjc/work/KJCStudio/logs/8765.log</string>
	<key>StandardOutPath</key>
	<string>/Users/kjc/work/KJCStudio/logs/8765.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/kjc/work/KJCStudio/holdings</string>
</dict>
</plist>
