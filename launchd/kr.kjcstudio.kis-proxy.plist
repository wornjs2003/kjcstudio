<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KJC_ROLE</key>
		<string>server</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
		<!-- **KIS 를 8765 하나로 (2026-10-01 · 길 (가)).** 이 서버가 **받는 쪽**이다 —
		     다른 서버들이 KJC_KIS_UPSTREAM 으로 여기로 넘긴다. 이것을 안 켜면 그 자리가
		     아예 없어(404) 보내는 쪽이 전부 폴백으로 직접 부른다 — 안 깨지지만 아무것도
		     안 모인다. 이름은 kis_proxy.py 와 tools/check-kis-single.py 가 대조한다. -->
		<key>KJC_KIS_UPSTREAM_SERVE</key>
		<string>1</string>
		<!-- **밤 한 바퀴(일·주·월·년봉 쌓기) · 롱폴링 켜기 (2026-10-03 지시 — 「(가)」).** 메인서버만 켠다 —
		     서비스방(8764)은 스위치를 따로 둔다. 이름은 kis_proxy.py 의 DWMY_ON · LONGPOLL_ON 이 읽는다.
		     이 파일을 고쳐도 **설치본에 넣고 재시작해야** 켜진다(「켜기」 는 따로 지시). -->
		<key>KJC_DWMY</key>
		<string>1</string>
		<key>KJC_LONGPOLL</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>kr.kjcstudio.kis-proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<!-- **`-u` 가 없으면 로그가 늦게 쓰인다** — 다른 plist 주석 참고 -->
		<string>-u</string>
		<string>server/kis_proxy.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/kjc/work/KJCStudio/logs/8765.log</string>
	<key>StandardOutPath</key>
	<string>/Users/kjc/work/KJCStudio/logs/8765.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/kjc/work/KJCStudio/holdings</string>
</dict>
</plist>
